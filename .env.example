# ---------------------------------------------------------------------------
# SHARKCARD environment. Copy to .env.local and fill in what you have.
# Anything left blank stays disabled, and the UI labels it as unavailable.
# ---------------------------------------------------------------------------

# demo | production. Production refuses to start without the two secrets below
# and never enables simulated providers for real accounts.
APP_MODE=demo
APP_URL=http://localhost:3000

# >= 32 random characters:  openssl rand -base64 48
SESSION_SECRET=
# 32 bytes, base64:          openssl rand -base64 32
DATA_ENCRYPTION_KEY=
DATABASE_PATH=.data/sharkcard.db

# Branding (both are public)
NEXT_PUBLIC_BRAND_NAME=SHARKCARD
NEXT_PUBLIC_TOKEN_TICKER=$SHARK
NEXT_PUBLIC_TOKEN_NAME=SHARKCARD
# Contact address on /terms and /privacy (falls back to a DM on X)
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Buying the token (third-party, user's own wallet) --------------------------
# MoonPay sells SOL to the user's wallet by card / Apple Pay / Google Pay; the user
# then swaps SOL for the token. The site never sells tokens or holds user money.
# Publishable key only (pk_...). Empty = card option shows "not configured".
MOONPAY_PUBLISHABLE_KEY=

# --- Pay with $SHARK --------------------------------------------------------------
# Members pay for Shark Cards with $SHARK from their own wallet (Solana Pay request).
# The server prices it from the price API, confirms the finalized transfer to the
# treasury on-chain, then orders the card. Checkout stays closed until TOKEN_MINT,
# the treasury and a fulfilment provider are all configured.
# Underpaid, late or undeliverable payments are marked refund_due in shark_payments
# and must be refunded from the treasury by an operator (the site holds no keys).
SHARK_TREASURY_WALLET=5f1oiop1b3Bxw8ppwbAECAVXq118mHGCVLEsp4EFPSxb
# Use a dedicated RPC (Helius, Triton, QuickNode…) in production; the public one is rate limited.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SHARK_PRICE_URL=https://lite-api.jup.ag/price/v3
SHARK_MIN_LIQUIDITY_USD=25000
SHARK_QUOTE_TTL_SECONDS=600

# --- Microsoft sign-in (personal accounts, OIDC + PKCE) --------------------
# Register an app at https://entra.microsoft.com, "Personal Microsoft accounts only",
# redirect URIs:  {APP_URL}/api/auth/microsoft/callback  and  {APP_URL}/api/auth/xbox/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Xbox profile verification (link-only, on top of Microsoft sign-in) ----
# Needs a relying party approved for Xbox services. Leave disabled until you have one;
# the button says "Microsoft", never "Xbox", while this is off.
XBOX_LINKING_ENABLED=false
XBOX_RELYING_PARTY=
XBOX_SANDBOX_ID=RETAIL

# --- Google sign-in (OIDC + PKCE, scopes "openid profile" only) -------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI:  {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- X sign-in (OAuth 2.0 + PKCE, confidential client) ----------------------
# developer.x.com > your app > User authentication settings: OAuth 2.0, type "Web App",
# permissions "Read", callback URI  {APP_URL}/api/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Steam (OpenID 2.0, verified server-side with check_authentication) ----
# Always on in demo mode. Web API key is optional and only used for the persona name.
STEAM_LOGIN_ENABLED=false
STEAM_WEB_API_KEY=

# --- PlayStation ------------------------------------------------------------
# Requires approved PlayStation Partners access. There is no integration in this build.
PLAYSTATION_PARTNER_ENABLED=false

# --- Email codes (passwordless fallback) ------------------------------------
# Without these, demo mode writes codes to a local dev outbox and shows them on screen.
RESEND_API_KEY=
EMAIL_FROM=

# --- Apple Wallet pass signing ------------------------------------------------
# Pass Type ID certificate from developer.apple.com + Apple WWDR intermediate (PEM paths).
# Without all of these, "Add to Apple Wallet" is not shown.
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT_PATH=
APPLE_PASS_KEY_PATH=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT_PATH=

# --- Fulfillment ---------------------------------------------------------------
# "none" is the only value: no licensed Shark Card distributor is integrated.
# Live redemption fails closed (503) until a provider adapter is added.
FULFILLMENT_PROVIDER=none
FULFILLMENT_WEBHOOK_SECRET=

# --- Chain data (pushed by your indexer; finalized commitment only) -----------
# Requests are signed:  x-ingest-signature: t=<unix>,v1=<hex hmac-sha256(secret, "t.body")>
CHAIN_INGEST_SECRET=
# Public mint address of the token. Also switches on the "Buy" section's swap
# links. Leave empty until the mint is final: the section then shows "not live".
TOKEN_MINT=
TOKEN_DECIMALS=6
TOKEN_PROGRAM=token-2022

# --- Reward engine -------------------------------------------------------------
REWARD_FEE_BPS=200
HOLDER_SHARE_BPS=8000
CREDIT_USD_MICROS=10000
PENDING_CLEARANCE_HOURS=72
PERIOD_LENGTH_DAYS=7
MIN_ELIGIBLE_BALANCE=1000
